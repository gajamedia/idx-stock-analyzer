# IDX Stock Analyzer - Environment Variables
# Copy this file to .env and fill in your API keys

# Alpha Vantage API Key (free: 25 requests/day)
# Get key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Finnhub API Key (free: 60 requests/minute)
# Get key at: https://finnhub.io/register
FINNHUB_API_KEY=

# Optional: Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server Config
HOST=0.0.0.0
PORT=8000
