[Unit]
Description=IDX Stock Analyzer
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/idx-stock-analyzer
ExecStart=/opt/idx-stock-analyzer/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000 --workers 2 --log-level info
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
